    {
     "field_id": "unit.assessment",
     "label": "评价方式与量规",
     "required": true,
     "order": 6,
     "input": "rubric_ref"
    }
   ],
   "sample": "teaching-units.json 的 demo-unit-radical 即按本模板填写（status=confirmed 的认可样例候选）。",
